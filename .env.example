# Timezone for daily episode IDs and schedules
TZ=Asia/Jakarta

# Google Flow (gflow-cli 0.105+) settings
GFLOW_CLI_MAX_CREDITS=0
FLOW_IMAGE_MODEL=nano-2.1
FLOW_VIDEO_MODEL=omni-1.2-flash
FLOW_DRY_RUN=true

# Indonesian TTS settings (edge-tts)
TTS_VOICE_ID=id-ID-ArdiNeural
TTS_RATE=+10%
TTS_PITCH=+0Hz

# Safety gate: never auto-upload generated videos without explicit manual review
ENABLE_AUTO_UPLOAD=false
